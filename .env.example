AUTH_INTERNAL_URL=http://127.0.0.1:18080
AUTH_BROWSER_ORIGIN=http://127.0.0.1:18080
WEB_PUBLIC_ORIGIN=http://localhost:13000
WEB_CSRF_SECRET=<random server-only secret, at least 32 characters>
DEVFIELD_BFF_SERVICE_KEY=<raw BFF key from Auth ignored .local/client-keys.ps1>
# Enable only providers with configured Auth credentials and completed real browser E2E.
WEB_ENABLED_OAUTH_PROVIDERS=
PROJECT_INTERNAL_URL=http://127.0.0.1:18081
# Project Service must register WEB_PUBLIC_ORIGIN/api/github/connections/callback
# and WEB_PUBLIC_ORIGIN/api/github/connections/setup as its GitHub App redirect URLs.
INTERVIEW_INTERNAL_URL=http://127.0.0.1:18082
# Add service credentials only in an ignored local file during Phase 2.
